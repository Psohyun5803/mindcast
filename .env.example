# .env.example
# 이 파일을 복사해서 .env로 저장한 뒤 값을 채워주세요.
#   cp .env.example .env

# ── HuggingFace ──────────────────────────────────────────────
HF_TOKEN=hf_your_token_here

# ── emotion_classifier 경로 (선택) ───────────────────────────
# 미지정 시 personalrepo/ 기준 기본 경로 사용
# EC_DATA_DIR=
# EC_MODEL_DIR=
# EC_HF_SOURCE=MindCastSogang/Youtube_news_preprocessed_data
# EC_HF_MAX_FILES=10
